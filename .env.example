# ============================================================================
# CRM MCP — environment
# Copy this file to `.env` and fill in the values, then `docker compose up`.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# From your Supabase project → Project Settings → API.

# Same URL, used by both services. (NEXT_PUBLIC_* is what the dashboard inlines.)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Anon (public) key — safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — MCP server ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Encryption ───────────────────────────────────────────────────────────────
# 32-byte key used to encrypt Private Integration Tokens at rest.
# The dashboard encrypts with it; the MCP server decrypts with it — they MUST match.
# Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public base URL of the MCP server. The dashboard uses it to build the
# /mcp/<token> links it shows to clients. In production set this to your
# externally reachable URL (e.g. https://mcp.youragency.com).
NEXT_PUBLIC_MCP_BASE_URL=http://localhost:8000

# ── GHL Marketplace OAuth (premium auth path — optional) ─────────────────────
# From your GHL Marketplace app. The dashboard runs the install/callback and the
# MCP server refreshes/mints tokens, so both services need the client id/secret.
# Leave blank to run PIT-only.
GHL_OAUTH_CLIENT_ID=your-marketplace-app-client-id
GHL_OAUTH_CLIENT_SECRET=your-marketplace-app-client-secret
# Must exactly match a redirect URI registered on the app, e.g.
# https://app.youragency.com/api/oauth/crm/callback
GHL_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/crm/callback
# Space-separated scopes the app requests (must match the app's scopes).
GHL_OAUTH_SCOPES=locations.readonly contacts.readonly contacts.write
# The app id (used to filter installedLocations).
GHL_APP_ID=your-marketplace-app-id
# Secret used to sign the OAuth `state` (CSRF). Falls back to ENCRYPTION_KEY.
# Generate with:  openssl rand -hex 32
OAUTH_STATE_SECRET=replace-with-64-hex-chars
# Public base URL of the DASHBOARD (for OAuth redirects back to the app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── White-label custom domains — Cloudflare for SaaS (optional) ──────────────
# Cloudflare issues + renews per-agency TLS certs (Custom Hostnames). Create an
# API token scoped to the SaaS zone with "SSL and Certificates: Edit".
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-saas-zone-id
# The hostname agencies CNAME their domain to (your Cloudflare SaaS fallback
# origin), e.g. mcp.youragency.com or customers.youragency.com.
CF_SAAS_CNAME_TARGET=mcp.youragency.com

# ── MCP server ────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=production
